# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/scrape_verse_db
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000

# JWT Authentication
ACCESS_TOKEN_SECRET=super_secret_access_jwt_key_change_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_change_in_production
BCRYPT_ROUNDS=10

# AI & Intelligence Providers
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Bright Data Web Unlocker & SERP API Configuration (Optional)
# Format 1: Full Proxy URL
# BRIGHT_DATA_PROXY_URL=http://brd-customer-<customer_id>-zone-<zone>:<password>@brd.superproxy.io:33335
# Format 2: Credentials Breakdown
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=web_unlocker
BRIGHT_DATA_SERP_ZONE=srape_verse_serp
BRIGHT_DATA_CUSTOMER_ID=
BRIGHT_DATA_ZONE_PASSWORD=
BRIGHT_DATA_COUNTRY=

# Brevo / Mail Settings (Transactional Emails & Alerts)
BREVO_API_KEY=
BREVO_SENDER_NAME=ScrapeVerse
BREVO_SENDER_EMAIL=noreply@example.com
SENDING_USER="scrape-verse <noreply@example.com>"
SEND_MAIL=false

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
